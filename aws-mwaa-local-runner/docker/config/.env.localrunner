# Any environment variables set in this .env.localrunner file will be set in local-runner on start
# LocalStack (docker_mwaa compose): use test creds; endpoint is set in docker-compose-local.yml
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# to change default password you'll need to delete the db-data folder (when running locally)
DEFAULT_PASSWORD="test"
S3_DAGS_PATH=""
S3_PLUGINS_PATH=""
S3_REQUIREMENTS_PATH=""

# Shorter DagRun note demo (default in DAG is 600s). Remove or raise for full 10m run.
DAGRUN_NOTE_DEMO_RUNNER_SEC=180
