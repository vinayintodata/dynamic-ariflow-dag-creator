# Copy to .env and adjust. https://docs.localstack.cloud/aws/licensing/

# Optional: LocalStack license token (Ultimate/Enterprise for MWAA + Redshift Data API).
# LOCALSTACK_AUTH_TOKEN=

# 1 = attempt LocalStack MWAA (requires Ultimate/Enterprise; Docker socket is mounted).
ENABLE_LOCALSTACK_MWAA=0

MWAA_ENV_NAME=local-mwaa-env

# 0 = skip uploading ./dags and mwaa-requirements.txt into the emulated S3 bucket on startup.
SEED_MWAA_S3=1

# 0 = skip the short Redshift "available" poll in localstack-init (faster startup).
REDSHIFT_WAIT=1

DEBUG=0
PERSISTENCE=1
MWAA_S3_POLL_INTERVAL=30
